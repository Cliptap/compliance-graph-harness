{
  "version": 1,
  "description": "Labeled cases per v2 control. `expected` is the label for the named control; other controls may also fire on the same code.",
  "cases": [
    {
      "id": "log_raw_rut",
      "control": "v2.log_pii",
      "expected": "violation",
      "path": "app/main.py",
      "code": "def f(customer):\n    logger.info('rut=%s', customer['rut'])\n"
    },
    {
      "id": "log_masked_rut",
      "control": "v2.log_pii",
      "expected": "clean",
      "path": "app/main.py",
      "code": "def f(customer):\n    logger.info('rut_fp=%s', _fingerprint(secret, customer['rut']))\n"
    },
    {
      "id": "log_plain_message",
      "control": "v2.log_pii",
      "expected": "clean",
      "path": "app/main.py",
      "code": "def f(order_id):\n    logger.info('order %s created', order_id)\n"
    },
    {
      "id": "admin_response_rut",
      "control": "v2.admin_exposure",
      "expected": "violation",
      "path": "app/main.py",
      "code": "def admin_customers(customer):\n    return {'rut': customer['rut']}\n"
    },
    {
      "id": "self_service_rut",
      "control": "v2.admin_exposure",
      "expected": "clean",
      "path": "app/main.py",
      "code": "def profile(customer):\n    return {'rut': customer['rut']}\n"
    },
    {
      "id": "admin_response_masked_rut",
      "control": "v2.admin_exposure",
      "expected": "clean",
      "path": "app/main.py",
      "code": "def admin_customers(customer):\n    return {'rut': mask_rut(customer['rut'])}\n"
    },
    {
      "id": "admin_response_variable_rut",
      "control": "v2.admin_exposure",
      "expected": "violation",
      "path": "app/main.py",
      "code": "def admin_export(customer):\n    payload = {'rut': customer['rut']}\n    return Response(content=json.dumps(payload))\n"
    },
    {
      "id": "admin_response_variable_masked",
      "control": "v2.admin_exposure",
      "expected": "clean",
      "path": "app/main.py",
      "code": "def admin_export(customer):\n    payload = {'rut': mask_rut(customer['rut'])}\n    return Response(content=json.dumps(payload))\n"
    },
    {
      "id": "admin_dict_row_customers",
      "control": "v2.admin_exposure",
      "expected": "violation",
      "path": "app/main.py",
      "code": "def admin_customer(customer_id):\n    row = db.execute('SELECT * FROM customers WHERE id = ?', (customer_id,)).fetchone()\n    return dict(row)\n"
    },
    {
      "id": "credential_dict_row_customers",
      "control": "v2.credential_response",
      "expected": "violation",
      "path": "app/main.py",
      "code": "def admin_customer(customer_id):\n    row = db.execute('SELECT * FROM customers WHERE id = ?', (customer_id,)).fetchone()\n    return dict(row)\n"
    },
    {
      "id": "credential_projection_is_clean",
      "control": "v2.credential_response",
      "expected": "clean",
      "path": "app/main.py",
      "code": "def active():\n    rows = db.execute('SELECT c.id FROM customers c').fetchall()\n    return [row['id'] for row in rows]\n"
    },
    {
      "id": "credential_hashed_is_clean",
      "control": "v2.credential_response",
      "expected": "clean",
      "path": "app/main.py",
      "code": "def admin_customer(row):\n    return {'password_hash': hash_secret(row['password_hash'])}\n"
    },
    {
      "id": "billing_delete_90_days",
      "control": "v2.billing_retention",
      "expected": "violation",
      "path": "app/main.py",
      "code": "def purge():\n    cutoff = now() - timedelta(days=90)\n    db.execute('DELETE FROM orders WHERE created_at < ?', (cutoff,))\n"
    },
    {
      "id": "billing_delete_retention_aware",
      "control": "v2.billing_retention",
      "expected": "clean",
      "path": "app/main.py",
