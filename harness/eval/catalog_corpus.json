    },
    {
      "id": "reset_generic_redirect",
      "control": "v2.reset_token",
      "expected": "clean",
      "path": "app/main.py",
      "code": "def reset():\n    return RedirectResponse('/sent', status_code=303)\n"
    },
    {
      "id": "api_key_response",
      "control": "v2.api_key",
      "expected": "violation",
      "path": "app/main.py",
      "code": "def config():\n    return {'api_key': os.environ['PAYMENTS_API_KEY']}\n"
    },
    {
      "id": "api_key_configured_flag",
      "control": "v2.api_key",
      "expected": "clean",
      "path": "app/main.py",
