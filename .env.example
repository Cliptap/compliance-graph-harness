# Copy to .env and fill the values you need. Never commit real credentials or personal data.

# OpenCode Go / Cursor credentials (experiment runner only).
OPENCODEGO_API_KEY=
CURSOR_API_KEY=

# Demo application. These are development defaults, not production secrets.
DATABASE_URL=postgresql+asyncpg://postgres:super_password@localhost:5432/vibedb
SECRET_KEY=change-me
APP_SECRET=change-me
ADMIN_TOKEN=change-me
SHOP_DB=experiments/supermercado/data/shop.db

# Runner overrides (optional).
VIBECODING_HARNESS_ROOT=
VIBECODING_WORKSPACE=
OPENCODE_BIN=
